---
import '../styles/tokens.css';
import '../styles/site.css';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, htmlLang, pagePath, hasPage, defaultLocale, type Locale, type PageKey } from '../i18n/locales';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
}
const { locale, page, title, description } = Astro.props;
const uiEntry = await getEntry('ui', locale);
if (!uiEntry) throw new Error(`Missing ui content for locale "${locale}"`);
const ui = uiEntry.data;
const abs = (path: string) => new URL(path, Astro.site).href;
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(pagePath(page, locale))} />
    {locales.filter((l) => hasPage(page, l)).map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(pagePath(page, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pagePath(page, defaultLocale))} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
  </head>
  <body>
    <Header ui={ui} locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer ui={ui} locale={locale} />
  </body>
</html>
