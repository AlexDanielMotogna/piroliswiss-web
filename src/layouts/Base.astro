---
import '../styles/tokens.css';
import '../styles/site.css';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { img } from '../lib/images';
import { jsonLd, GA_ID } from '../lib/seo';
import ConsentBanner from '../components/ConsentBanner.astro';
import { locales, htmlLang, pagePath, hasPage, defaultLocale, type Locale, type PageKey } from '../i18n/locales';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  /** Name of the page in the breadcrumb (inner pages only). */
  crumb?: string;
  /** Error pages and draft legal pages: no canonical, no alternates, not indexed. */
  noindex?: boolean;
}
const { locale, page, title, description, crumb, noindex = false } = Astro.props;
// Preview image for WhatsApp, LinkedIn, etc.: the hero photo at 1200×630.
const og = await getImage({ src: img('hero'), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const uiEntry = await getEntry('ui', locale);
if (!uiEntry) throw new Error(`Missing ui content for locale "${locale}"`);
const ui = uiEntry.data;
const abs = (path: string) => new URL(path, Astro.site).href;
const url = abs(pagePath(page, locale));
const ld = jsonLd({
  site: abs('/'),
  url,
  lang: htmlLang[locale],
  description,
  logo: abs('/icon-512.png'),
  crumbs: crumb ? [{ name: ui.crumbHome, url: abs(pagePath('home', locale)) }, { name: crumb, url }] : undefined,
});
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <!-- Google Analytics in consent mode: no analytics cookies until the visitor accepts (ConsentBanner) -->
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      try { if (localStorage.getItem('px-consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : (
      <Fragment>
        <link rel="canonical" href={url} />
        <meta property="og:url" content={url} />
        <script type="application/ld+json" set:html={ld} />
        {locales.filter((l) => hasPage(page, l)).map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(pagePath(page, l))} />)}
        <link rel="alternate" hreflang="x-default" href={abs(pagePath(page, defaultLocale))} />
      </Fragment>
    )}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Piroliswiss" />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header ui={ui} locale={locale} page={page} markCurrent={!noindex} />
    <main id="main">
      {crumb && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <a href={pagePath('home', locale)}>{ui.crumbHome}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{crumb}</span>
        </nav>
      )}
      <slot />
    </main>
    <Footer ui={ui} locale={locale} />
    <ConsentBanner ui={ui} locale={locale} />
  </body>
</html>
