---
/**
 * Inner pages built from the home content: products, process & quality
 * (retort, comparison, Piroliswiss Control), export and contact. The first heading on each page is
 * its <h1>; every page except contact closes with the contact band.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from './SectionHead.astro';
import Photo from './Photo.astro';
import Product from './Product.astro';
import PyrolysisScale from './PyrolysisScale.astro';
import ControlSection from './ControlSection.astro';
import CompareTable from './CompareTable.astro';
import RequestForm from './RequestForm.astro';
import CtaBand from './CtaBand.astro';
import { resolveHref, type Locale } from '../i18n/locales';

export type InnerPage = 'products' | 'process' | 'export' | 'contact';

interface Props {
  locale: Locale;
  page: InnerPage;
}
const { locale, page } = Astro.props;
const [homeEntry, uiEntry, companyEntry] = await Promise.all([
  getEntry('home', locale),
  getEntry('ui', locale),
  getEntry('company', locale),
]);
if (!homeEntry || !uiEntry || !companyEntry) throw new Error(`Missing content for locale "${locale}"`);
const t = homeEntry.data;
const ui = uiEntry.data;
const co = companyEntry.data;

// Page title and description come from each section's own heading copy.
const meta = {
  products: { label: t.products.label, text: t.products.lede },
  process: { label: t.process.label, text: t.process.lede },
  export: { label: t.export.label, text: t.export.lede },
  contact: { label: t.request.label, text: t.request.text },
}[page];
// Breadcrumb/title: the menu label where the page is in the menu, otherwise the section label.
const crumb = ui.nav.find((n) => n.href === page)?.label ?? meta.label;
---
<Base locale={locale} page={page} title={ui.seo[page].title} description={ui.seo[page].description} crumb={crumb}>
  {page === 'products' && (
    <section class="products page-top">
      <div class="wrap">
        <SectionHead label={t.products.label} title={t.products.title} lede={t.products.lede} wide level={1} />
        <nav class="prod-index" aria-label={t.products.indexLabel}>
          {t.products.items.map((p, i) => (
            <a href={`#${p.id}`}><span class="prod-thumb"><Photo src={p.indexImg} alt={p.indexAlt} sizes="96px" /></span><span class="prod-name"><span class="label">{String(i + 1).padStart(2, '0')}</span>{p.navLabel}</span></a>
          ))}
        </nav>
        {t.products.items.map((p, i) => <Product p={p} n={i + 1} locale={locale} />)}
      </div>
    </section>
  )}

  {page === 'process' && (
    <Fragment>
      <section class="band page-top">
        <div class="wrap">
          <SectionHead label={t.process.label} title={t.process.title} lede={t.process.lede} mutedLede={false} level={1} />
          <PyrolysisScale process={t.process} />
        </div>
      </section>
      <section>
        <CompareTable compare={t.compare} />
      </section>
      <ControlSection control={t.control} />
    </Fragment>
  )}

  {page === 'export' && (
    <section class="page-top">
      <div class="wrap">
        <SectionHead label={t.export.label} title={t.export.title} lede={t.export.lede} wide level={1} />
        <div class="export-grid">
          {t.export.blocks.map((b) => (
            <div>
              <h2 class="label">{b.title}</h2>
              <ul>{b.lines.map((l) => <li>{l}</li>)}</ul>
            </div>
          ))}
        </div>
        <div class="export-photos">
          {t.export.photos.map((ph) => <figure><Photo src={ph.img} alt={ph.alt} sizes="(max-width: 700px) 100vw, 50vw" /></figure>)}
        </div>
      </div>
    </section>
  )}

  {page === 'contact' && <RequestForm req={t.request} locale={locale} level={1} />}

  {page !== 'contact' && (
    <CtaBand title={co.cta.title} text={co.cta.text} cta={ui.requestCta} href={resolveHref('contact', locale)} />
  )}
</Base>
