---
/**
 * World map with the countries where a species grows highlighted in leaf green
 * (datasheets, owner request 2026-10-01). Paths are pre-projected in
 * src/data/world-map.json (Natural Earth 1:110m, Natural Earth projection,
 * Spanish country names); `range` holds ISO 3166 numeric codes. Hovering or
 * tapping a country shows its name, plus the range label and any per-country
 * data from `data` (keyed by the same codes). `home` (Bolivia) gets its own
 * colour and label. A legend under the map explains both colours.
 */
import map from '../data/world-map.json';

interface Props {
  range: string[];
  caption: string;
  status: string;
  data?: Record<string, string>;
  home?: string;
  homeLabel?: string;
}
const { range, caption, status, data = {}, home, homeLabel } = Astro.props;
const on = new Set(range);
// highlighted countries last so their borders draw on top; home on top of all
const rank = (id: string) => (id === home ? 2 : on.has(id) ? 1 : 0);
const countries = [...map.countries].sort((a, b) => rank(a.id) - rank(b.id));
const homeName = map.countries.find((c) => c.id === home)?.name;
---
<figure class="range-map">
  <div class="range-stage">
    <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-label={caption}>
      {countries.map((c) => (
        <path
          d={c.d}
          class:list={{ on: on.has(c.id), home: c.id === home }}
          data-name={c.name}
          data-home={c.id === home ? homeLabel : undefined}
          data-status={on.has(c.id) ? status : undefined}
          data-info={data[c.id]}
        />
      ))}
    </svg>
    <div class="range-tip" role="status" hidden></div>
  </div>
  <figcaption>
    <span class="range-key"><i class="sw-on"></i>{caption}</span>
    {home && homeLabel && <span class="range-key"><i class="sw-home"></i>{homeName} / {homeLabel}</span>}
  </figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('.range-map')) {
    const stage = fig.querySelector<HTMLElement>('.range-stage')!;
    const tip = fig.querySelector<HTMLElement>('.range-tip')!;
    let active: SVGPathElement | null = null;

    const show = (path: SVGPathElement, x: number, y: number) => {
      if (path !== active) {
        active?.classList.remove('hot');
        path.classList.add('hot');
        active = path;
        const { name = '', home, status, info } = path.dataset;
        tip.replaceChildren();
        const b = document.createElement('b');
        b.textContent = name;
        tip.append(b);
        for (const line of [home, status, info]) {
          if (!line) continue;
          const s = document.createElement('span');
          s.textContent = line;
          tip.append(s);
        }
        tip.classList.toggle('on', !!(status || home));
        tip.classList.toggle('home', path.classList.contains('home'));
        tip.hidden = false;
      }
      const r = stage.getBoundingClientRect();
      const left = Math.min(x - r.left + 14, r.width - tip.offsetWidth);
      const top = y - r.top - tip.offsetHeight - 12;
      tip.style.left = `${Math.max(0, left)}px`;
      tip.style.top = `${top < 0 ? y - r.top + 18 : top}px`;
    };
    const hide = () => {
      active?.classList.remove('hot');
      active = null;
      tip.hidden = true;
    };

    stage.addEventListener('pointermove', (e) => {
      const t = e.target;
      if (t instanceof SVGPathElement) show(t, e.clientX, e.clientY);
      else hide();
    });
    stage.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') hide(); });
    // touch: tap a country to show it, tap the sea to close
    stage.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof SVGPathElement) show(t, e.clientX, e.clientY);
      else hide();
    });
  }
</script>
