---
import SectionHead from './SectionHead.astro';
import SpecTable from './SpecTable.astro';
import Tbc from './Tbc.astro';
import Photo from './Photo.astro';
import type { Company } from '../lib/types';

interface Props {
  team: Company['team'];
  facts: Company['facts'];
}
const { team, facts } = Astro.props;
---
<section id="team" class="flush team-sec">
  <div class="wrap">
    <SectionHead label={team.label} title={team.title} />
    <ul class="people">
      {team.members.map((m) => (
        <li class="person">
          <figure class:list={[{ 'has-photo': m.photo }]}>
            {m.photo ? <Photo src={m.photo} alt={m.name} sizes="(max-width: 560px) 100vw, (max-width: 860px) 50vw, 30vw" /> : <Tbc text={team.photo} />}
          </figure>
          <h3 class="h-m">{m.name}</h3>
          <p class="label">{m.role}</p>
          <a class="mail" href={`mailto:${m.email}`}>{m.email}</a>
        </li>
      ))}
    </ul>
    <div class="facts">
      <p class="label">{facts.label}</p>
      <SpecTable rows={facts.rows} />
    </div>
  </div>
</section>
