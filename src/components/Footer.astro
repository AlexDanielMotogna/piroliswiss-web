---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import Tbc from './Tbc.astro';
import type { Ui } from '../lib/types';
import { resolveHref, type Locale } from '../i18n/locales';

interface Props {
  ui: Ui;
  locale: Locale;
}
const { ui, locale } = Astro.props;
const f = ui.footer;
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="brand">
        <Image src={img('mark')} alt={f.markAlt} width={128} />
        <p>{f.about}</p>
      </div>
      {f.columns.map((c) => (
        <div>
          <h2>{c.title}</h2>
          <ul>{c.links.map((l) => <li><a href={resolveHref(l.href, locale)}>{l.label}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h2>{f.contact.title}</h2>
        <ul>
          <li><a href={`mailto:${f.contact.email}`}>{f.contact.email}</a></li>
          <li>{f.contact.address}</li>
          <li>{f.contact.city}</li>
          <li><Tbc text={f.contact.phone} /></li>
        </ul>
      </div>
    </div>
    <div class="legal"><span>{f.copyright}</span><span>{f.imprint} · {f.privacy}</span></div>
  </div>
</footer>
