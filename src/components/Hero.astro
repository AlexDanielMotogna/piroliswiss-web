---
import Photo from './Photo.astro';
import type { Home } from '../lib/types';

interface Props {
  hero: Home['hero'];
  cta: string;
}
const { hero, cta } = Astro.props;
---
<div class="hero">
  <Photo src={hero.img} alt={hero.alt} sizes="100vw" eager />
  <div class="coord">{hero.location[0]}<br />{hero.location[1]}</div>
  <div class="wrap">
    <p class="label">{hero.eyebrow}</p>
    <h1 class="h-xl">{hero.title}</h1>
    <p class="sub">{hero.sub}</p>
    <div class="actions">
      <a class="btn" href="#request">{cta} <span class="arr" aria-hidden="true">→</span></a>
      <a class="btn ghost" href="#process">{hero.secondary}</a>
    </div>
  </div>
</div>
