---
import { Picture } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  eager?: boolean;
}
const { src, alt, sizes, eager = false } = Astro.props;
const meta = img(src);
const widths = [400, 640, 960, 1280, 1920].filter((w) => w <= meta.width);
if (!widths.includes(meta.width) && meta.width < 1920) widths.push(meta.width);
---
<Picture
  src={meta}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
/>
