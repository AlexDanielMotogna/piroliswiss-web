---
/**
 * Home: a short overview that routes each visitor to the inner pages.
 * Full content lives on /productos/, /proceso/, /trazabilidad/,
 * /modelo-operativo/, /escalabilidad/, /empresa/ and /contacto/.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import SpecStrip from './SpecStrip.astro';
import SectionHead from './SectionHead.astro';
import Photo from './Photo.astro';
import AboutSection from './AboutSection.astro';
import RequestForm from './RequestForm.astro';
import { resolveHref, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [homeEntry, uiEntry, companyEntry] = await Promise.all([
  getEntry('home', locale),
  getEntry('ui', locale),
  getEntry('company', locale),
]);
if (!homeEntry || !uiEntry || !companyEntry) throw new Error(`Missing content for locale "${locale}"`);
const t = homeEntry.data;
const ui = uiEntry.data;
const co = companyEntry.data;

// Teasers for the inner pages: each reuses its section's own label and headline.
const navLabel = (k: string) => ui.nav.find((n) => n.href === k)?.label ?? '';
// `note` marks images that are renderings, not photos.
const explore: { href: string; img: string; alt: string; label: string; title: string; note?: string }[] = [
  { href: 'process', img: 'ProcesoYcalidad', alt: t.model.steps[2]!.alt, label: navLabel('process'), title: t.process.title, note: t.model.steps[2]!.note },
  { href: 'process#control', img: 'control-all', alt: t.control.label, label: t.control.label, title: t.control.title },
  { href: 'fichas', img: '07-operaciones/foto-3', alt: t.ops.photos[2]!.alt, label: t.products.label, title: t.products.items[0]!.woodsLink ?? '' },
  { href: 'export', img: '07-operaciones/foto-5', alt: t.export.photos[1]!.alt, label: t.export.label, title: t.export.title },
];
---
<Base locale={locale} page="home" title={t.meta.title} description={t.meta.description}>
  <Hero hero={t.hero} cta={ui.requestCta} locale={locale} />
  <SpecStrip plant={t.plant} />

  <section class="why">
    <div class="wrap">
      <SectionHead label={t.why.label} title={t.why.title} />
      <ol class="why-grid">
        {t.why.items.map((w) => <li><h3>{w.title}</h3><p>{w.text}</p></li>)}
      </ol>
    </div>
  </section>

  <AboutSection intro={co.intro} />

  <section class="flush">
    <div class="wrap">
      <SectionHead label={t.problems.label} title={t.problems.title} />
      <div class="problems">
        {t.problems.items.map((p) => (
          <article class="problem">
            <figure><Photo src={p.img} alt={p.alt} sizes="(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 25vw" /></figure>
            <h3 class="h-m">{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="solutions">
        <p class="label">{t.problems.solutionLabel}</p>
        <div class="sol-body">
          <h2 class="h-m sol-title">{t.problems.solutionTitle}</h2>
          <div class="sol-grid">
            {t.problems.solutions.map((s) => <div><figure class="sol-photo"><Photo src={s.img} alt={s.alt} sizes="(max-width: 1000px) 100vw, 25vw" /></figure><h3>{s.title}</h3><p>{s.text}</p></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="products home-products">
    <div class="wrap">
      <SectionHead label={t.products.label} title={t.products.title} lede={t.products.lede} wide />
      <div class="home-prod-grid">
        {t.products.items.map((p, i) => (
          <a href={resolveHref(`products#${p.id}`, locale)}>
            <span class="home-prod-img"><Photo src={p.indexImg} alt={p.indexAlt} sizes="(max-width: 700px) 100vw, 30vw" /></span>
            <span class="label"><span class="prod-num">{String(i + 1).padStart(2, '0')}</span> / {p.tag}</span>
            <b>{p.navLabel}</b>
          </a>
        ))}
      </div>
      <p class="more-row"><a class="link" href={resolveHref('products', locale)}>{ui.more}</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="explore">
        {explore.map((e) => (
          <a href={resolveHref(e.href, locale)}>
            <figure><Photo src={e.img} alt={e.alt} sizes="(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 25vw" />{e.note && <span class="explore-note">{e.note}</span>}</figure>
            <p class="label">{e.label}</p>
            <h3>{e.title.replace(/[.。]$/, '')}</h3>
            <span class="more">{ui.more}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <RequestForm req={t.request} locale={locale} title={co.cta.title} text={co.cta.text} />
</Base>
