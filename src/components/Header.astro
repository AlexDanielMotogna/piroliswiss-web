---
import type { Ui } from '../lib/types';
import {
  locales,
  htmlLang,
  switchLabel,
  langName,
  localeRoot,
  pagePath,
  hasPage,
  resolveHref,
  type Locale,
  type PageKey,
} from '../i18n/locales';

interface Props {
  ui: Ui;
  locale: Locale;
  page: PageKey;
}
const { ui, locale, page } = Astro.props;
const nav = ui.nav.map((l) => ({ ...l, url: resolveHref(l.href, locale), current: l.href === page }));
const request = resolveHref('contact', locale);
---
<a class="skip" href="#main">{ui.skip}</a>
<header class="top" id="top">
  <div class="wrap">
    <a class="wordmark" href={localeRoot(locale)} aria-label={ui.home}>PIROLI<span>SWISS</span><svg class="flag" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" fill="#D40000"/><path d="M13 6h6v7h7v6h-7v7h-6v-7H6v-6h7z" fill="#fff"/></svg></a>
    <nav class="nav" aria-label={ui.navLabel}>
      {nav.map((l) => <a href={l.url} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <details class="lang" data-dropdown>
      <summary aria-label={`${ui.langLabel}: ${langName[locale]}`}>{switchLabel[locale]}</summary>
      <ul class="lang-panel">
        {locales.map((l) => (
          <li>
            <a
              href={hasPage(page, l) ? pagePath(page, l) : localeRoot(l)}
              hreflang={htmlLang[l]}
              lang={htmlLang[l]}
              aria-current={l === locale ? 'true' : undefined}
            ><span class="code">{switchLabel[l]}</span>{langName[l]}</a>
          </li>
        ))}
      </ul>
    </details>
    <a class="btn" href={request}>{ui.requestCta} <span class="arr" aria-hidden="true">→</span></a>
    <details class="menu" data-dropdown>
      <summary>{ui.menu}</summary>
      <div class="menu-panel">
        <ul>
          {nav.map((l) => <li><a href={l.url} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
          <li><a href={request}>{ui.requestCta} <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </details>
  </div>
</header>
<script>
  const top = document.getElementById('top')!;
  const onScroll = () => top.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Dropdowns: one open at a time; close on outside click, Escape or link click.
  const drops = [...top.querySelectorAll<HTMLDetailsElement>('[data-dropdown]')];
  drops.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) drops.forEach((o) => o !== d && (o.open = false));
    });
    d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (d.open = false)));
  });
  document.addEventListener('click', (e) => {
    drops.forEach((d) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    drops.forEach((d) => {
      if (d.open) {
        d.open = false;
        d.querySelector('summary')?.focus();
      }
    });
  });
</script>
