---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from './SectionHead.astro';
import SpecTable from './SpecTable.astro';
import Tbc from './Tbc.astro';
import { resolveHref, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entry = await getEntry('company', locale);
const uiEntry = await getEntry('ui', locale);
if (!entry || !uiEntry) throw new Error(`Missing company content for locale "${locale}"`);
const c = entry.data;
const ui = uiEntry.data;
---
<Base locale={locale} page="company" title={c.meta.title} description={c.meta.description}>
  <section class="page-intro">
    <div class="wrap">
      <SectionHead label={c.intro.label} title={c.intro.title} level={1} />
      <div class="about">
        {c.intro.items.map((a) => <div><p class="label">{a.label}</p><p>{a.text}</p></div>)}
      </div>
    </div>
  </section>

  <section id="team" class="flush">
    <div class="wrap">
      <SectionHead label={c.team.label} title={c.team.title} />
      <ul class="people">
        {c.team.members.map((m) => (
          <li class="person">
            <figure><Tbc text={c.team.photo} /></figure>
            <h3 class="h-m">{m.name}</h3>
            <p class="label">{m.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="flush">
    <div class="wrap">
      <div class="facts">
        <p class="label">{c.facts.label}</p>
        <SpecTable rows={c.facts.rows} />
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2 class="h-l">{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn" href={resolveHref('#request', locale)}>{ui.requestCta} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
