---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AboutSection from './AboutSection.astro';
import TeamSection from './TeamSection.astro';
import { resolveHref, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entry = await getEntry('company', locale);
const uiEntry = await getEntry('ui', locale);
if (!entry || !uiEntry) throw new Error(`Missing company content for locale "${locale}"`);
const c = entry.data;
const ui = uiEntry.data;
---
<Base locale={locale} page="company" title={c.meta.title} description={c.meta.description}>
  <AboutSection intro={c.intro} level={1} class="page-intro" />
  <TeamSection team={c.team} facts={c.facts} />

  <section class="cta-band">
    <div class="wrap">
      <h2 class="h-l">{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn" href={resolveHref('#request', locale)}>{ui.requestCta} <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
