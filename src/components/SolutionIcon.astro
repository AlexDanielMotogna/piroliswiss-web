---
/**
 * Custom line icons for the "Our solution" block (owner request 2026-09-26).
 * Drawn for this site, not from an icon pack: white strokes, one red accent each.
 */
interface Props {
  name: 'residue' | 'supply' | 'agro';
}
const { name } = Astro.props;
---
<span class="sol-icon" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" stroke-width="2" stroke-linejoin="miter" stroke-linecap="square">
    {name === 'residue' && (
      <Fragment>
        {/* log end with growth rings, turning into product */}
        <circle cx="15" cy="24" r="11" stroke="currentColor" />
        <circle cx="15" cy="24" r="6" stroke="currentColor" />
        <circle cx="15" cy="24" r="1.5" fill="currentColor" stroke="none" />
        <path d="M31 24h12M38 19l5 5-5 5" class="accent" />
      </Fragment>
    )}
    {name === 'supply' && (
      <Fragment>
        {/* plant with chimney on a continuous line */}
        <path d="M6 40V24l9 5v-5l9 5v-5l9 5V10h8v30z" stroke="currentColor" />
        <path d="M2 44h44" class="accent" />
      </Fragment>
    )}
    {name === 'agro' && (
      <Fragment>
        {/* leaf with a drop */}
        <path d="M8 38C8 21 19 10 36 8c-1 17-11 30-28 30z" stroke="currentColor" />
        <path d="M8 38l18-18" stroke="currentColor" />
        <path d="M38 29c-3 4-5 7-5 9a5 5 0 0010 0c0-2-2-5-5-9z" class="accent solid" />
      </Fragment>
    )}
  </svg>
</span>
