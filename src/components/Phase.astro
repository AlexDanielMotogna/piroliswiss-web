---
import Photo from './Photo.astro';
import type { Home } from '../lib/types';

interface Props {
  phase: Home['scale']['phases'][number];
}
const { phase } = Astro.props;
---
<article class="phase">
  <figure>
    <Photo src={phase.img} alt={phase.alt} sizes="(max-width: 860px) 100vw, 30vw" />
  </figure>
  <p class:list={['label', 'phase-tag', { planned: phase.planned }]}>{phase.tag}</p>
  <h3 class="h-m">{phase.title}</h3>
  {phase.text && <p>{phase.text}</p>}
  {phase.lines && <ul class="phase-lines">{phase.lines.map((l) => <li>{l}</li>)}</ul>}
  {phase.timeline && (
    <table class="phase-timeline">
      <tbody>{phase.timeline.map((r) => <tr><th scope="row">{r.year}</th><td>{r.label}</td></tr>)}</tbody>
    </table>
  )}
</article>
