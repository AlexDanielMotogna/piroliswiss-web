---
import type { Home } from '../lib/types';

interface Props {
  plant: Home['plant'];
}
const { plant: p } = Astro.props;
---
<div class="specs">
  <div class="wrap plant">
    <div class="plant-main">
      <p class="plant-figure"><span class="plus">+</span>{p.figure}<span class="plant-unit">{p.unit}</span></p>
      <p class="plant-caption">{p.figureLabel}</p>
    </div>
    <ul class="plant-facts">
      {p.facts.map((f) => <li>{f}</li>)}
    </ul>
  </div>
</div>
