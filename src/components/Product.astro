---
import Photo from './Photo.astro';
import { img } from '../lib/images';
import SpecTable from './SpecTable.astro';
import type { Home } from '../lib/types';
import { pagePath, type Locale } from '../i18n/locales';

interface Props {
  p: Home['products']['items'][number];
  n: number;
  locale: Locale;
}
const { p, n, locale } = Astro.props;
const num = String(n).padStart(2, '0');
// e.g. the acid photo is 550 px wide: keep its own size and ratio instead of cropping to fill the column
const src = img(p.img);
const small = src.width < 900;
---
<article class="prod" id={p.id}>
  <figure class:list={[{ natural: small }]} style={small ? `max-width:${src.width}px;aspect-ratio:${src.width}/${src.height}` : undefined}>
    <Photo src={p.img} alt={p.alt} sizes={small ? `${src.width}px` : '(max-width: 1000px) 100vw, 40vw'} />
  </figure>
  <div class="prod-body">
    <p class="label">{num} · {p.tag}</p>
    <h3 class="h-l prod-title">{p.title}</h3>
    <p class="prod-desc">{p.desc}</p>
    {p.spec ? (
      <div class="prod-cols">
        <div>
          <p class="label prod-sub">{p.featLabel}</p>
          <ul class="feat">{p.features.map((f) => <li>{f}</li>)}</ul>
        </div>
        <div>
          <p class="label prod-sub">{p.specLabel}</p>
          <SpecTable rows={p.spec} />
        </div>
      </div>
    ) : (
      <Fragment>
        <p class="label prod-sub">{p.featLabel}</p>
        <ul class="feat two">{p.features.map((f) => <li>{f}</li>)}</ul>
      </Fragment>
    )}
    <div class="apps">
      <span class="label">{p.appLabel}</span>
      <p>{p.app}</p>
      {p.output && <p class="apps-out"><span>{p.outputLabel}</span><b>{p.output.v}</b></p>}
    </div>
    <div class="prod-links">
      <a class="link" href="#request">{p.cta}</a>
      {p.woodsLink && <a class="link link-2" href={pagePath('woods', locale)}>{p.woodsLink} <span aria-hidden="true">→</span></a>}
    </div>
  </div>
</article>
