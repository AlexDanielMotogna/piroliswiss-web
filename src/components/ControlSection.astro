---
import SectionHead from './SectionHead.astro';
import Photo from './Photo.astro';
import type { Home } from '../lib/types';

interface Props {
  control: Home['control'];
}
const { control: c } = Astro.props;
---
<section id="control" class="control">
  <div class="wrap">
    <SectionHead label={c.label} title={c.title} lede={c.lede} />
    <div class="control-grid">
      <div class="shots" data-slider>
        <div class="shots-track" tabindex="0">
          {c.slides.map((s, i) => (
            <figure class="shot" id={`shot-${i}`} aria-label={s.label}>
              <Photo src={s.img} alt={s.alt} sizes="(max-width: 1000px) 100vw, 58vw" eager={i === 0} />
            </figure>
          ))}
        </div>
        <div class="shots-dots">
          {c.slides.map((s, i) => (
            <button type="button" aria-label={s.label} aria-current={i === 0 ? 'true' : 'false'} data-go={i}></button>
          ))}
        </div>
      </div>
      <div>
        <ul class="control-points">
          {c.points.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
        <p class="control-note">{c.note}</p>
      </div>
    </div>
  </div>
</section>
<script>
  // Auto-advancing scroll-snap carousel: next slide every 5 s; pauses on hover, focus,
  // touch, hidden tab, and never runs with prefers-reduced-motion.
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.shots-track')!;
    const count = track.children.length;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    let current = 0;
    const mark = (i: number) => {
      current = i;
      dots.forEach((d, j) => d.setAttribute('aria-current', String(j === i)));
    };
    const go = (i: number) => {
      const n = (i + count) % count;
      mark(n);
      track.scrollTo({ left: n * track.clientWidth, behavior: 'smooth' });
    };
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.go)); restart(); }));

    let t: number | undefined;
    track.addEventListener('scroll', () => {
      clearTimeout(t);
      t = window.setTimeout(() => mark(Math.round(track.scrollLeft / track.clientWidth)), 120);
    }, { passive: true });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    let paused = false;
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      if (reduced || paused || document.hidden || timer) return;
      timer = window.setInterval(() => go(current + 1), 5000);
    };
    const restart = () => { stop(); start(); };
    const pause = () => { paused = true; stop(); };
    const resume = () => { paused = false; start(); };
    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', resume);
    track.addEventListener('touchstart', pause, { passive: true });
    track.addEventListener('touchend', () => window.setTimeout(resume, 3000), { passive: true });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>
