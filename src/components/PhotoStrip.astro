---
import Photo from './Photo.astro';
import type { Home } from '../lib/types';

interface Props {
  photos: Home['ops']['photos'];
}
---
<div class="strip">
  {Astro.props.photos.map((p, i) => (
    <figure>
      <Photo src={p.img} alt={p.alt} sizes={i === 0 ? '(max-width: 860px) 100vw, 50vw' : '(max-width: 860px) 50vw, 25vw'} />
    </figure>
  ))}
</div>
